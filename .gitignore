# Build output
/bin/
/dist/
/pangolin
*.exe
*.exe~
*.dll
*.so
*.dylib
*.app/
*.syso
# ...except the Windows icon resource, which the Go linker picks up by name
!/cmd/pangolin/rsrc_windows_amd64.syso
fyne-cross/

# Go
*.test
*.out
*.prof
coverage.*
/vendor/
go.work
go.work.sum

# Vaults and key material: never commit these, not even test ones
vault.db
vault.db-journal
vault.db-wal
vault.db-shm
vault.db.orphan-*
vault.header
vault.header.*.tmp
# ...except the vaults of past releases the compatibility test opens
# (test password only)
!/internal/vault/testdata/releases/*/vault.db
!/internal/vault/testdata/releases/*/vault.header
*.vault
*.key
*.pem
*.p12
*.kdbx
.env
.env.*

# Editors and IDEs
.idea/
.vscode/
*.iml
*.swp
*.swo
*~
.claude/

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.log
*.bak
/tmp/
shots/
